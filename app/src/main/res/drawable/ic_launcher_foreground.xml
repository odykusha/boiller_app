<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Battery icon (left side) -->
    <group
        android:translateX="30"
        android:translateY="40">
        <!-- Battery body -->
        <path
            android:fillColor="#00D4FF"
            android:pathData="M-12,-10 L-12,10 L12,10 L12,-10 Z"/>
        <!-- Battery fill (green, 95%) -->
        <path
            android:fillColor="#00FF96"
            android:pathData="M-10,-8 L-10,8 L10,8 L10,-8 Z"/>
        <!-- Battery terminal -->
        <path
            android:fillColor="#00D4FF"
            android:pathData="M12,-3 L16,-3 L16,3 L12,3 Z"/>
    </group>
    
    <!-- Lightning bolt (center) -->
    <group
        android:translateX="54"
        android:translateY="40">
        <path
            android:fillColor="#00D4FF"
            android:pathData="M-6,8 L-2,8 L0,0 L-4,0 L-6,-8 L6,-8 L4,0 L8,0 L6,8 L-2,8 Z"/>
    </group>
    
    <!-- Light bulb (right side) -->
    <group
        android:translateX="78"
        android:translateY="40">
        <!-- Bulb shape -->
        <path
            android:fillColor="#00D4FF"
            android:pathData="M-8,-10 Q-8,-14 -4,-14 Q0,-14 0,-10 Q0,-6 4,-6 Q8,-6 8,-10 Q8,-14 4,-14 Q0,-14 0,-10 Q0,-6 -4,-6 Q-8,-6 -8,-10 Z"/>
        <!-- Bulb base -->
        <path
            android:fillColor="#00D4FF"
            android:pathData="M-4,-10 L-4,-6 L4,-6 L4,-10 L2,-10 L2,-8 L-2,-8 L-2,-10 Z"/>
        <!-- Light rays -->
        <path
            android:strokeColor="#00D4FF"
            android:strokeWidth="1.5"
            android:pathData="M-12,-6 L-8,-6 M12,-6 L8,-6 M0,-18 L0,-14"/>
    </group>
    
</vector>
